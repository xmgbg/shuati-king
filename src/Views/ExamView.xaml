<UserControl x:Class="ShuatiKing.Views.ExamView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontSize="16" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources>
  <Style x:Key="TypeCircle" TargetType="CheckBox">
   <Setter Property="Width" Value="28"/><Setter Property="Height" Value="36"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Width="20" Height="20"><Ellipse x:Name="Ring" Stroke="{DynamicResource LineBrush}" StrokeThickness="2" Fill="{DynamicResource SurfaceBrush}"/><Ellipse x:Name="Dot" Margin="5" Fill="Transparent"/></Grid><ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Ring" Property="StrokeThickness" Value="3"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TypeDragHandle" TargetType="Button">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="36"/><Setter Property="Cursor" Value="SizeAll"/>
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Handle" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
     <Path Data="M 0,0 L 14,0 M 0,5 L 14,5 M 0,10 L 14,10" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource TintBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource TintBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Handle" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="PageLayout" Margin="30,24,30,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="PageHeader"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <TextBlock x:Name="PageHeading" Text="模拟考试" Style="{StaticResource PageTitle}"/>
   <Grid Grid.Column="2" Visibility="{Binding ElementName=Setup, Path=Visibility}">
    <Border x:Name="ResumeCard" Background="{DynamicResource TintBrush}" Padding="16,8" CornerRadius="7" HorizontalAlignment="Right" MaxWidth="620" Visibility="Collapsed">
     <DockPanel><Button x:Name="ResumeExamButton" Content="继续考试 ›" DockPanel.Dock="Right" Click="OpenPrevious" BorderThickness="0" Background="Transparent" Padding="12,6" MinHeight="32" Margin="12,0,0,0"/><TextBlock x:Name="ResumeText" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/></DockPanel>
    </Border>
   </Grid>
  </Grid>
  <ScrollViewer Grid.Row="2" x:Name="Setup" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Border x:Name="SetupCard" Style="{StaticResource Panel}" Padding="0" VerticalAlignment="Top">
    <StackPanel>
     <Grid x:Name="BankToolbar" Margin="28,24"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Label Content="考试题库" Target="{Binding ElementName=BankPicker}" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="SemiBold" Padding="0" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="2" x:Name="BankPicker" Width="380" ItemTemplate="{StaticResource BankPickerTemplate}" SelectionChanged="SettingsChanged" AutomationProperties.Name="考试题库"/>
      <TextBlock Grid.Column="4" x:Name="BankSource" VerticalAlignment="Center" Style="{StaticResource MutedText}" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
     </Grid>
     <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Margin="12,0,12,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition MinWidth="280" MaxWidth="440"/></Grid.ColumnDefinitions>
       <Border x:Name="TypeTableSection" Padding="24">
        <StackPanel>
         <TextBlock x:Name="TypeHeading" Text="题型设置" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,18"/>
         <Grid x:Name="TableHeader" Height="48" Background="{DynamicResource CanvasBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" MinWidth="152"/><ColumnDefinition MinWidth="80"/><ColumnDefinition MinWidth="100"/><ColumnDefinition MinWidth="100"/><ColumnDefinition Width="0.75*" MinWidth="70"/></Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="题型" Style="{StaticResource MutedText}" FontSize="14" Margin="76,0,0,0"/>
          <TextBlock VerticalAlignment="Center" Grid.Column="1" Text="可用题量" Style="{StaticResource MutedText}" FontSize="14" HorizontalAlignment="Center"/>
          <TextBlock VerticalAlignment="Center" Grid.Column="2" Text="抽取题量" Style="{StaticResource MutedText}" FontSize="14" HorizontalAlignment="Center"/>
          <TextBlock VerticalAlignment="Center" Grid.Column="3" Text="每题分值" Style="{StaticResource MutedText}" FontSize="14" HorizontalAlignment="Center"/>
          <TextBlock VerticalAlignment="Center" Grid.Column="4" Text="小计" Style="{StaticResource MutedText}" FontSize="14" HorizontalAlignment="Center"/>
         </Grid>
         <ScrollViewer x:Name="TypeRowsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="TypeRows"/></ScrollViewer>
         <TextBlock x:Name="SelectionSummary" FontSize="14" Margin="4,20,0,0"/>
        </StackPanel>
       </Border>
       <Border Grid.Column="1" Background="{DynamicResource TintBrush}" Opacity="0.35" CornerRadius="0,5,5,0"/>
       <Border Grid.Column="1" x:Name="ExamSummarySection" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="32">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock x:Name="ExamSettingsHeading" Text="考试设置" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,30"/>
         <StackPanel Grid.Row="1"><Label Content="考试时长" Target="{Binding ElementName=MinutesInput}" Foreground="{DynamicResource TextBrush}" Padding="0" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><TextBox x:Name="MinutesInput" Text="30" Width="112" Height="42" MaxLength="4" AutomationProperties.Name="考试时长分钟"/><TextBlock Text="分钟" Margin="14,0,0,0"/></StackPanel></StackPanel>
         <Border Grid.Row="2" x:Name="SummaryDivider" Height="1" Background="{DynamicResource LineBrush}" Margin="0,28"/>
         <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="题目总数" FontSize="14"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock x:Name="QuestionTotal" Text="25" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="44"/><TextBlock Text="题" Margin="8,0,0,0" VerticalAlignment="Bottom" Padding="0,0,0,7"/></StackPanel></StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,6"/>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="试卷满分" FontSize="14"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock x:Name="PaperTotal" Text="40" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="44"/><TextBlock Text="分" Margin="8,0,0,0" VerticalAlignment="Bottom" Padding="0,0,0,7"/></StackPanel></StackPanel>
         </Grid>
         <StackPanel Grid.Row="5" x:Name="SummaryActions" Margin="0,24,0,0">
          <Button x:Name="StartExamButton" Content="开始考试" Height="52" Style="{StaticResource PrimaryButton}" Click="StartExam"/>
          <ToggleButton x:Name="RulesButton" Content="ⓘ 评分规则" Margin="0,14,0,0" Foreground="{DynamicResource MutedBrush}" Cursor="Hand" Height="28" AutomationProperties.Name="查看评分规则">
           <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="RuleLink" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RuleLink" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Popup x:Name="RulesPopup" PlacementTarget="{Binding ElementName=RulesButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding ElementName=RulesButton, Path=IsChecked, Mode=TwoWay}">
           <Border Style="{StaticResource Panel}" Padding="20" Width="310" Margin="8"><StackPanel><TextBlock Text="评分规则" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="多选题须全部选对，少选或错选不得分。&#x0a;填空题须所有空匹配才得分。&#x0a;未作答题目计零分。" Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap" LineHeight="25"/><TextBlock Text="暂停或关闭软件后保留作答与剩余时间；继续后恢复计时，时间归零自动交卷。" Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap" LineHeight="25" Margin="0,12,0,0"/></StackPanel></Border>
          </Popup>
         </StackPanel>
        </Grid>
       </Border>
      </Grid>
     </Border>
    </StackPanel>
   </Border>
  </ScrollViewer>
  <Grid Grid.Row="2" x:Name="ExamPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition/></Grid.RowDefinitions>
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock x:Name="ClockText" Foreground="{DynamicResource AccentBrush}" FontSize="28" FontWeight="SemiBold" Margin="0,0,24,0"/><Button x:Name="PauseButton" Content="暂停考试" Click="PauseClick" Margin="0,0,12,0"/><Button x:Name="SubmitPaperButton" Content="交卷" Style="{StaticResource PrimaryButton}" Click="AskSubmit"/></StackPanel><StackPanel><TextBlock x:Name="PaperName" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="AnsweredCount" Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,0"/></StackPanel></DockPanel>
   <Grid Grid.Row="2" x:Name="QuizGrid"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="QuestionPosition" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16"/><ContentControl x:Name="QuestionHost"/></StackPanel></ScrollViewer><DockPanel Grid.Row="1" Margin="0,18,0,0"><Button x:Name="NextButton" Content="下一题" DockPanel.Dock="Right" Click="Next"/><Button x:Name="PreviousButton" Content="上一题" HorizontalAlignment="Left" Click="Previous"/></DockPanel></Grid></Border>
    <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top"><StackPanel><TextBlock Text="答题卡" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="浅蓝色表示已作答，点击编号切换。" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="13" Margin="0,10,0,18"/><ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="QuestionMap"/></ScrollViewer><Button Content="保存并返回设置" Click="BackToSetup" Margin="0,20,0,0"/></StackPanel></Border>
   </Grid>
   <Border Grid.Row="2" x:Name="PausedPanel" Style="{StaticResource Panel}" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620"><TextBlock Text="考试已暂停" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="作答与剩余时间已保存在本机。暂停时不计时，继续后恢复倒计时。" Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="28" TextAlignment="Center" Margin="0,20,0,26"/><Button x:Name="ContinueExamButton" Content="继续考试" Style="{StaticResource PrimaryButton}" Click="ResumeClick"/></StackPanel></Border>
   <Border x:Name="SubmitConfirmation" Grid.RowSpan="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="40" CornerRadius="8" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="确认交卷？" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="ConfirmText" TextWrapping="Wrap" LineHeight="28" Margin="0,20,0,24"/><TextBlock Text="确认期间倒计时继续；到时会自动交卷。" Style="{StaticResource MutedText}" FontSize="14" Margin="0,0,0,24"/><WrapPanel><Button x:Name="CancelSubmitButton" Content="继续作答" Click="CancelSubmit" Margin="0,0,12,0"/><Button x:Name="ConfirmSubmitButton" Content="确认交卷" Style="{StaticResource PrimaryButton}" Click="ConfirmSubmit"/></WrapPanel></StackPanel></Border>
  </Grid>
  <Border Grid.Row="2" x:Name="ResultPanel" Style="{StaticResource Panel}" Padding="0" Visibility="Collapsed">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
    <DockPanel Margin="20,16,20,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="返回组卷设置" Click="BackToSetup" Padding="12,8" MinHeight="36" FontSize="14" Margin="0,0,8,0"/><Button x:Name="ResultHistoryButton" Content="考试记录" Style="{StaticResource PrimaryButton}" Padding="12,8" MinHeight="36" FontSize="14" Margin="0,0,8,0"/><Button Content="错题本" Click="OpenWrongs" Padding="12,8" MinHeight="36" FontSize="14"/></StackPanel><TextBlock x:Name="ResultHeading" Text="已交卷" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,16,0"/></DockPanel>
    <ContentControl Grid.Row="2" x:Name="ResultDetailHost"/>
   </Grid>
  </Border>
  <TextBlock Grid.Row="3" x:Name="Feedback" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="14" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,12,0,0"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </Grid>
</UserControl>
