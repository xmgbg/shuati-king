<UserControl x:Class="ShuatiKing.Views.ExamResultView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,16,20,18">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="BankName" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ExamDate" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/><TextBlock x:Name="Summary" FontSize="14" TextWrapping="Wrap" LineHeight="24" Margin="0,8,0,0"/></StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="考试成绩" FontSize="13" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="Score" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2" Margin="20,0,20,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="178"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="QuestionPosition" FontSize="14" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="1" x:Name="Outcome" FontSize="16" FontWeight="SemiBold"/></Grid>
    <ScrollViewer Grid.Row="2" x:Name="ReviewScroll" VerticalScrollBarVisibility="Auto">
     <StackPanel><ContentControl x:Name="QuestionHost"/><Border Background="{DynamicResource TintBrush}" CornerRadius="6" Padding="16" Margin="0,12,0,0"><StackPanel><TextBlock x:Name="YourAnswer" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock x:Name="CorrectAnswer" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock x:Name="Explanation" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></Border></StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="3" Margin="0,16,0,0"><Button x:Name="NextButton" Content="下一题" DockPanel.Dock="Right" Click="Next"/><Button x:Name="PreviousButton" Content="上一题" HorizontalAlignment="Left" Click="Previous"/></DockPanel>
   </Grid>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Text="逐题结果" FontSize="16" FontWeight="SemiBold"/><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="QuestionMap"/></ScrollViewer>
   </Grid>
  </Grid>
 </Grid>
</UserControl>