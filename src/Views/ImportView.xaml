<UserControl x:Class="ShuatiKing.Views.ImportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontSize="16" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="30,24,30,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="66"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="导入资料" Style="{StaticResource PageTitle}"/></StackPanel>
  <UniformGrid Grid.Row="1" Columns="4" VerticalAlignment="Center"><TextBlock x:Name="StepSource" Text="01  选择资料"/><TextBlock x:Name="StepPreview" Text="02  预览与修正"/><TextBlock x:Name="StepGenerate" Text="03  生成 / 识别"/><TextBlock Text="04  审核入库" Style="{StaticResource MutedText}"/></UniformGrid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Padding="24"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <StackPanel x:Name="SourcePage">
     <TextBlock Text="资料包含什么内容？" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,16"/>
     <UniformGrid Columns="2" Margin="0,0,0,8"><RadioButton x:Name="KnowledgeMode" Content="知识资料 → 生成新题" GroupName="ContentKind" IsChecked="True" Style="{StaticResource Choice}" Checked="ContentKindChanged"/><RadioButton x:Name="ExistingMode" Content="现成题目 → 整理审核" GroupName="ContentKind" Style="{StaticResource Choice}" Checked="ContentKindChanged"/></UniformGrid>
     <TextBlock x:Name="PathHint" Text="先检查资料文字，再选择题型和数量生成题目。" Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,22"/>
     <Label Content="题库名称" Target="{Binding ElementName=LibraryNameInput}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,8"/><TextBox x:Name="LibraryNameInput" MaxLength="60" AutomationProperties.Name="新题库名称"/>
     <TextBlock Text="资料来源" Margin="0,20,0,12"/>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><RadioButton x:Name="PasteMode" Content="粘贴文字" GroupName="SourceKind" IsChecked="True" Style="{StaticResource Choice}" Checked="SourceKindChanged" Padding="16,10"/><RadioButton x:Name="FileMode" Content="PDF / Word 文件" GroupName="SourceKind" Style="{StaticResource Choice}" Checked="SourceKindChanged"/></StackPanel>
     <StackPanel x:Name="FileControls" Visibility="Collapsed" Margin="0,0,0,14"><Button Content="选择 PDF 或 .docx 文件" Click="ChooseFile" HorizontalAlignment="Left"/><TextBlock x:Name="SelectedFile" Text="尚未选择文件" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="支持文字型 PDF 和 .docx，不支持扫描件识别。" Foreground="{DynamicResource WarningBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
     <ProgressBar x:Name="ReadProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,12"/>
     <TextBlock x:Name="ReadStatus" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock x:Name="InputLabel" Text="粘贴资料文字" Margin="0,0,0,10"/>
     <TextBox x:Name="SourceInput" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="210" VerticalContentAlignment="Top" AutomationProperties.Name="资料原文"/>
    </StackPanel>
    <StackPanel x:Name="PreviewPage" Visibility="Collapsed">
     <TextBlock Text="预览与修正" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,16"/>
     <TextBlock x:Name="DocumentSummary" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox x:Name="SourceLocations" Background="Transparent" BorderThickness="0" SelectionChanged="LocationChanged" MaxHeight="350" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="资料来源位置">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="LocationRow" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="10,12"><ContentPresenter/></Border><ControlTemplate.Triggers>
         <Trigger Property="IsSelected" Value="True"><Setter TargetName="LocationRow" Property="Background" Value="{DynamicResource TintBrush}"/><Setter TargetName="LocationRow" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
         <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="LocationRow" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LocationRow" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
       </Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Location}" TextWrapping="Wrap" FontSize="14"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Column="2">
       <TextBlock x:Name="LocationTitle" FontWeight="SemiBold" Margin="0,0,0,10"/>
       <TextBox x:Name="PreviewInput" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="260" VerticalContentAlignment="Top" TextChanged="PreviewChanged" AutomationProperties.Name="提取内容预览与修正"/>
       <Expander x:Name="OriginalExpander" Foreground="{DynamicResource MutedBrush}" Header="提取原文" Margin="0,12,0,0"><TextBox x:Name="OriginalInput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="160" AutomationProperties.Name="当前来源提取原文"/></Expander>
      </StackPanel>
     </Grid>
     <TextBlock x:Name="PreviewNote" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="13" Margin="0,14,0,0"/>
    </StackPanel>
    <StackPanel x:Name="GeneratePage" Visibility="Collapsed">
     <TextBlock x:Name="GenerateTitle" Text="选择题型与数量" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <TextBlock x:Name="GenerateDescription" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="14" Margin="0,0,0,20"/>
     <StackPanel x:Name="KnowledgeSettings">
      <UniformGrid Columns="5" Margin="0,0,0,12">
       <StackPanel Margin="0,0,12,0"><Label Content="单选题" Target="{Binding ElementName=SingleCount}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,8"/><TextBox x:Name="SingleCount" TextChanged="TargetsChanged" Text="4" MaxLength="3" AutomationProperties.Name="单选题数量"/></StackPanel>
       <StackPanel Margin="0,0,12,0"><Label Content="多选题" Target="{Binding ElementName=MultipleCount}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,8"/><TextBox x:Name="MultipleCount" TextChanged="TargetsChanged" Text="2" MaxLength="3" AutomationProperties.Name="多选题数量"/></StackPanel>
       <StackPanel Margin="0,0,12,0"><Label Content="判断题" Target="{Binding ElementName=JudgmentCount}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,8"/><TextBox x:Name="JudgmentCount" TextChanged="TargetsChanged" Text="2" MaxLength="3" AutomationProperties.Name="判断题数量"/></StackPanel>
       <StackPanel Margin="0,0,12,0"><Label Content="填空题" Target="{Binding ElementName=BlankCount}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,8"/><TextBox x:Name="BlankCount" TextChanged="TargetsChanged" Text="2" MaxLength="3" AutomationProperties.Name="填空题数量"/></StackPanel>
       <StackPanel><Label Content="计算题" Target="{Binding ElementName=CalculationCount}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,8"/><TextBox x:Name="CalculationCount" TextChanged="TargetsChanged" Text="0" MaxLength="3" AutomationProperties.Name="计算题数量"/></StackPanel>
      </UniformGrid>
      <TextBlock Text="数量为 0 时不生成该题型。每种题型最多 100 道。" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"/>

     </StackPanel>
     <TextBlock x:Name="TaskPlanSummary" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
     <Button x:Name="GenerateButton" Content="生成草稿" Click="GenerateClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,22,0,0"/>
     <Button x:Name="CancelImportButton" Content="暂停识别" Click="CancelImport" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,12,0,0"/>
     <Expander x:Name="ImportReportPanel" Header="处理报告" Visibility="Collapsed" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,0"><TextBox x:Name="ImportReport" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="未导入与重复题目明细"/></Expander>
     <ProgressBar x:Name="GenerationProgress" Height="5" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" Margin="0,18,0,0"/>
     <Border x:Name="ResultPanel" Background="{DynamicResource TintBrush}" CornerRadius="6" Padding="18" Margin="0,20,0,0" Visibility="Collapsed"><StackPanel><TextBlock x:Name="GenerationFeedback" TextWrapping="Wrap" LineHeight="26" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="ActualCounts" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
    </StackPanel>
   </StackPanel></ScrollViewer></Border>
   <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top" Padding="22"><StackPanel><TextBlock Text="本次导入" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="RouteSummary" Text="知识资料 → 预览文字 → 生成草稿 → 审核入库" TextWrapping="Wrap" LineHeight="27" Margin="0,18,0,18"/><Border Height="1" Background="{DynamicResource LineBrush}"/><TextBlock Text="草稿先审核，确认后可练习。缺答案的题目会保留为待补全。" Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap" LineHeight="25" Margin="0,18,0,18"/><TextBlock x:Name="FlowNotice" Text="知识资料出题暂为示例结果。" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" LineHeight="24" Margin="0,8,0,0"/><TextBlock x:Name="PreservedDraftHint" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource WarningBrush}" Margin="0,18,0,0"/></StackPanel></Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,18,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="BackButton" Content="返回题库" Click="Back" Margin="0,0,12,0"/><Button x:Name="NextButton" Content="预览内容  ›" Click="Next" Style="{StaticResource PrimaryButton}"/></StackPanel><TextBlock x:Name="FormFeedback" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" FontSize="14" Margin="0,0,20,0" AutomationProperties.LiveSetting="Polite"/></DockPanel>
 </Grid>
</UserControl>
