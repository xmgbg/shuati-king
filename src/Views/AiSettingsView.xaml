<UserControl x:Class="ShuatiKing.Views.AiSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}" FontSize="16">
 <UserControl.Resources><Style x:Key="FieldLabel" TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="0,0,0,8"/></Style></UserControl.Resources>
 <StackPanel>
  <DockPanel><Button x:Name="AddButton" DockPanel.Dock="Right" Content="＋ 新增配置" Click="AddConfiguration" Padding="12,8" FontSize="14"/><StackPanel Orientation="Horizontal"><TextBlock Text="AI 配置" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ConfigurationCount" Style="{StaticResource MutedText}" FontSize="13" Margin="14,0,0,0"/></StackPanel></DockPanel>
  <TextBlock Text="使用自己的服务地址、API 密钥和模型；最多保存三套。" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="14" Margin="0,10,0,20"/>
  <ListBox x:Name="ConfigurationTabs" SelectionChanged="ConfigurationSelected" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="AI 配置列表">
   <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ListBox.ItemsPanel>
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="TabBorder" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" Padding="14,12" CornerRadius="6"><ContentPresenter/></Border><ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TintBrush}"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Model, TargetNullValue=未设置模型}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" MinHeight="16"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Border Background="{DynamicResource TintBrush}" CornerRadius="6" Padding="14" Margin="0,16,0,20"><StackPanel><TextBlock x:Name="ActiveConfiguration" TextWrapping="Wrap" FontSize="14"/><TextBlock x:Name="RunningModel" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
  <StackPanel x:Name="Editor">
   <Label Content="配置名称" Target="{Binding ElementName=NameInput}" Style="{StaticResource FieldLabel}"/>
   <TextBox x:Name="NameInput" MaxLength="20" TextChanged="ConfigurationEdited" AutomationProperties.Name="配置名称"/>
   <Label Content="服务地址" Target="{Binding ElementName=EndpointInput}" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
   <TextBox x:Name="EndpointInput" TextChanged="ConfigurationEdited" AutomationProperties.Name="AI 服务地址"/>
   <TextBlock Text="填写服务方的 API 基础地址（如 https://api.xiaomimimo.com/v1），也支持完整的 /chat/completions 地址" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><Label Content="API 密钥" Target="{Binding ElementName=KeyInput}" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="KeyInput" PasswordChanged="ConfigurationEdited" AutomationProperties.Name="API 密钥"/></StackPanel>
    <StackPanel Grid.Column="2"><Label Content="模型名称" Target="{Binding ElementName=ModelInput}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ModelInput" TextChanged="ConfigurationEdited" AutomationProperties.Name="模型名称"/></StackPanel>
   </Grid>
   <TextBlock Text="密钥仅在本机加密保存。更换模型后，重启应用生效。" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,18"/>
   <WrapPanel><Button x:Name="SaveConfigurationButton" Content="保存配置" Style="{StaticResource PrimaryButton}" Click="SaveConfiguration" Margin="0,0,12,0"/><Button x:Name="UseConfigurationButton" Content="设为当前配置" Click="UseConfiguration"/></WrapPanel>
  </StackPanel>
  <TextBlock x:Name="ConfigurationFeedback" TextWrapping="Wrap" FontSize="14" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
  <Border x:Name="RestartNotice" Background="{DynamicResource WarningTintBrush}" Padding="14" CornerRadius="6" Margin="0,12,0,0" Visibility="Collapsed"><TextBlock Text="模型已更换，请重启应用后使用新模型。你可以稍后手动重启。" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="14"/></Border>
  <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,22,0,18"/>
  <TextBlock Text="检查连接" FontWeight="SemiBold"/>
  <TextBlock Text="检查当前正在编辑的配置，将发送一次简短模型请求，可能产生少量调用费用。" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,14"/>
  <Button x:Name="CheckButton" Content="检查连接" Click="CheckConnection" IsEnabled="False" Padding="14,10" HorizontalAlignment="Left"/>
  <Border x:Name="ConnectionResult" Background="{DynamicResource TintBrush}" CornerRadius="6" Padding="14" Margin="0,14,0,0" Visibility="Collapsed"><StackPanel><ProgressBar x:Name="CheckingProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/><TextBlock x:Name="ConnectionFeedback" TextWrapping="Wrap" FontSize="14" LineHeight="24" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
 </StackPanel>
</UserControl>
