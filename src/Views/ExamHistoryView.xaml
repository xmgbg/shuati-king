<UserControl x:Class="ShuatiKing.Views.ExamHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}" FontSize="16">
 <Grid Margin="30,24,30,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition/></Grid.RowDefinitions>
  <DockPanel><Button x:Name="NewExamButton" Content="模拟考试" DockPanel.Dock="Right" Click="NewExam"/><StackPanel Orientation="Horizontal"><TextBlock Text="考试记录" Style="{StaticResource PageTitle}"/><TextBlock x:Name="HistoryCount" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="20,0,0,0"/></StackPanel></DockPanel>
  <Grid Grid.Row="2" x:Name="HistoryGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Padding="0">
    <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" SelectionChanged="SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="历史考试列表">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="{DynamicResource SurfaceBrush}" Padding="16" BorderBrush="Transparent" BorderThickness="3,0,0,0"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource TintBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource TintBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding BankName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding FinishedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue=时间未记录}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/><TextBlock FontSize="20" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"><Run Text="{Binding Score, Mode=OneWay, StringFormat={}{0:0.##}}"/><Run Text=" / "/><Run Text="{Binding Total, Mode=OneWay, StringFormat={}{0:0.##}}"/><Run Text=" 分"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="0"><ContentControl x:Name="DetailHost"/></Border>
  </Grid>
  <Border Grid.Row="2" x:Name="EmptyPanel" Style="{StaticResource Panel}" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="还没有考试记录" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/><Button Content="去模拟考试" Style="{StaticResource PrimaryButton}" Margin="0,24,0,0" Click="NewExam"/></StackPanel></Border>
 </Grid>
</UserControl>