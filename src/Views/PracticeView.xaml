<UserControl x:Class="ShuatiKing.Views.PracticeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontSize="16" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources>
  <Geometry x:Key="SequentialIcon">M 3,10 A 9,9 0 0 1 20,6 M 15,6 L 20,6 L 20,1 M 21,14 A 9,9 0 0 1 4,18 M 9,18 L 4,18 L 4,23</Geometry>
  <Geometry x:Key="RandomIcon">M 2,5 L 6,5 C 12,5 12,19 18,19 L 22,19 M 18,15 L 22,19 L 18,23 M 2,19 L 6,19 C 12,19 12,5 18,5 L 22,5 M 18,1 L 22,5 L 18,9</Geometry>
  <Geometry x:Key="WrongIcon">M 5,2 L 16,2 L 22,8 L 22,26 L 3,26 L 3,4 Q 3,2 5,2 M 16,2 L 16,8 L 22,8 M 8,13 L 16,21 M 16,13 L 8,21</Geometry>
  <Style x:Key="PracticeModeCard" TargetType="RadioButton">
   <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="64"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Grid>
     <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="24,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="24"/><ColumnDefinition Width="24"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Viewbox Width="28" Height="28"><Path x:Name="ModeIcon" Data="{TemplateBinding Tag}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox>
       <Grid Grid.Column="2" Width="24" Height="24" VerticalAlignment="Center"><Ellipse x:Name="Ring" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2"/><Ellipse x:Name="Dot" Fill="Transparent" Margin="6"/></Grid>
       <ContentPresenter Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
      </Grid>
     </Border>
     <Border x:Name="FocusRing" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource TintBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="ModeIcon" Property="Stroke" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.85"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="PageLayout" Margin="30,24,30,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <TextBlock x:Name="PageHeading" Text="刷题练习" Style="{StaticResource PageTitle}"/>
   <Grid Grid.Column="2" Visibility="{Binding ElementName=Setup, Path=Visibility}">
    <Border x:Name="ResumeCard" Background="{DynamicResource TintBrush}" Padding="16,8" CornerRadius="7" HorizontalAlignment="Right" MaxWidth="620" Visibility="Collapsed">
     <DockPanel><Button x:Name="ResumeButton" Content="继续练习 ›" DockPanel.Dock="Right" Click="Continue" BorderThickness="0" Background="Transparent" Padding="12,6" MinHeight="32" Margin="12,0,0,0"/><TextBlock x:Name="ResumeText" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/></DockPanel>
    </Border>
   </Grid>
  </Grid>
  <ScrollViewer Grid.Row="2" x:Name="Setup" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Border Style="{StaticResource Panel}" Padding="0" VerticalAlignment="Top">
    <StackPanel>
     <Grid x:Name="BankToolbar" Margin="28,24"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Label Content="练习题库" Target="{Binding ElementName=BankPicker}" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="SemiBold" Padding="0" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="2" x:Name="BankPicker" Width="380" ItemTemplate="{StaticResource BankPickerTemplate}" SelectionChanged="SetupChanged" AutomationProperties.Name="练习题库"/>
      <TextBlock Grid.Column="4" x:Name="BankSource" Style="{StaticResource MutedText}" VerticalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
     </Grid>
     <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Margin="12,0,12,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition MinWidth="280" MaxWidth="440"/></Grid.ColumnDefinitions>
       <Border x:Name="ModesSection" Padding="24">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
         <TextBlock x:Name="ModesHeading" Text="练习方式" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,22"/>
         <Grid Grid.Row="1" x:Name="ModeChoices"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="16"/><RowDefinition/><RowDefinition Height="16"/><RowDefinition/></Grid.RowDefinitions>
          <RadioButton x:Name="SequentialMode" IsChecked="True" GroupName="PracticeMode" Style="{StaticResource PracticeModeCard}" Tag="{StaticResource SequentialIcon}" Checked="SetupChanged" AutomationProperties.Name="顺序练习"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="顺序练习"/><TextBlock Grid.Column="1" x:Name="SequentialCount" Foreground="{DynamicResource TextBrush}" FontWeight="Normal" Margin="16,0,0,0"/></Grid></RadioButton>
          <RadioButton Grid.Row="2" x:Name="RandomMode" GroupName="PracticeMode" Style="{StaticResource PracticeModeCard}" Tag="{StaticResource RandomIcon}" Checked="SetupChanged" AutomationProperties.Name="随机练习"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="随机练习"/><TextBlock Grid.Column="1" x:Name="RandomCount" Foreground="{DynamicResource TextBrush}" FontWeight="Normal" Margin="16,0,0,0"/></Grid></RadioButton>
          <RadioButton Grid.Row="4" x:Name="WrongMode" GroupName="PracticeMode" Style="{StaticResource PracticeModeCard}" Tag="{StaticResource WrongIcon}" Checked="SetupChanged" AutomationProperties.Name="错题重练"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="错题重练"/><TextBlock Grid.Column="1" x:Name="WrongCount" Foreground="{DynamicResource TextBrush}" FontWeight="Normal" Margin="16,0,0,0"/></Grid></RadioButton>
         </Grid>
        </Grid>
       </Border>
       <Border Grid.Column="1" Background="{DynamicResource TintBrush}" Opacity="0.35" CornerRadius="0,5,5,0"/>
       <Border Grid.Column="1" x:Name="RoundSummarySection" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="32">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock x:Name="RoundHeading" Text="本轮练习" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,20"/>
         <StackPanel Grid.Row="1"><TextBlock x:Name="ModeName" Text="顺序练习" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/><TextBlock Text="本轮题量" FontSize="14"/></StackPanel>
         <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0"><TextBlock x:Name="RoundCount" Text="128" FontSize="44" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="题" Margin="10,0,0,0" VerticalAlignment="Bottom" Padding="0,0,0,7"/></StackPanel>
         <Border Grid.Row="3" x:Name="SummaryDivider" Height="1" Background="{DynamicResource LineBrush}" Margin="0,20"/>
         <UniformGrid Grid.Row="4" x:Name="TypeDistribution" Rows="4" Height="112">
          <DockPanel><TextBlock x:Name="SingleCount" DockPanel.Dock="Right"/><TextBlock Text="单选题"/></DockPanel>
          <DockPanel><TextBlock x:Name="MultipleCount" DockPanel.Dock="Right"/><TextBlock Text="多选题"/></DockPanel>
          <DockPanel><TextBlock x:Name="JudgmentCount" DockPanel.Dock="Right"/><TextBlock Text="判断题"/></DockPanel>
          <DockPanel><TextBlock x:Name="BlankCount" DockPanel.Dock="Right"/><TextBlock Text="填空题"/></DockPanel>
         </UniformGrid>
         <StackPanel Grid.Row="6" x:Name="SummaryActions" Margin="0,24,0,0">
          <Button x:Name="StartButton" Content="开始练习" Height="52" Style="{StaticResource PrimaryButton}" Click="Start"/>
          <ToggleButton x:Name="RulesButton" Content="ⓘ 练习规则" Height="28" Foreground="{DynamicResource MutedBrush}" Cursor="Hand" Margin="0,14,0,0" AutomationProperties.Name="查看练习规则">
           <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="RuleLink" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RuleLink" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Popup x:Name="RulesPopup" PlacementTarget="{Binding ElementName=RulesButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding ElementName=RulesButton, Path=IsChecked, Mode=TwoWay}">
           <Border Style="{StaticResource Panel}" Padding="20" Width="310" Margin="8"><StackPanel><TextBlock Text="练习规则" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/><TextBlock Text="每题提交后查看答案与解析，本轮已提交答案不能修改。&#x0a;练习和考试答错均进入错题本，之后答对一次自动移出。&#x0a;退出后可继续上次练习。" Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap" LineHeight="25"/></StackPanel></Border>
          </Popup>
         </StackPanel>
        </Grid>
       </Border>
      </Grid>
     </Border>
    </StackPanel>
   </Border>
  </ScrollViewer>
  <Grid Grid.Row="2" x:Name="SessionPanel" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><ContentControl x:Name="QuestionHost"/><Border x:Name="AnswerResult" Background="{DynamicResource TintBrush}" Padding="18" CornerRadius="6" Visibility="Collapsed" Margin="0,20,0,0"><StackPanel><TextBlock x:Name="ResultTitle" FontWeight="SemiBold" FontSize="19"/><TextBlock x:Name="CorrectAnswer" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock x:Name="Explanation" Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="25" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
    <DockPanel Grid.Row="1" Margin="0,18,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SubmitButton" Content="提交答案" Style="{StaticResource PrimaryButton}" Click="Submit" Margin="0,0,12,0"/><Button x:Name="NextButton" Content="下一题" Click="Next"/></StackPanel><Button x:Name="PreviousButton" Content="上一题" HorizontalAlignment="Left" Click="Previous"/></DockPanel>
   </Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top"><StackPanel><TextBlock x:Name="SessionTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SessionMode" Style="{StaticResource MutedText}" Margin="0,10,0,18"/><TextBlock x:Name="Position" FontSize="26" FontWeight="SemiBold"/><ProgressBar x:Name="Progress" Height="6" Margin="0,16,0,16" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="CompletedCount" Style="{StaticResource MutedText}"/><TextBlock Text="提交前隐藏正确答案，提交后显示解析。已提交答案不能在本轮修改。" FontSize="14" Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="25" Margin="0,22,0,22"/><Button x:Name="BackButton" Content="保存并返回" Click="Back"/></StackPanel></Border>
  </Grid>
  <Border Grid.Row="2" x:Name="CompletionPanel" Style="{StaticResource Panel}" Visibility="Collapsed" VerticalAlignment="Top"><StackPanel><TextBlock Text="本轮练习已完成" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="CompletionText" FontSize="18" Margin="0,20,0,24"/><WrapPanel><Button Content="重新选择题库" Click="Back" Margin="0,0,12,0"/><Button Content="打开错题本" Click="OpenWrongs" Style="{StaticResource PrimaryButton}"/></WrapPanel></StackPanel></Border>
  <TextBlock Grid.Row="3" x:Name="Feedback" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="14" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,12,0,0"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </Grid>
</UserControl>
