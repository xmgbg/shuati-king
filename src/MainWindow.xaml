<Window x:Class="ShuatiKing.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="刷题KING" Width="1440" Height="900" MinWidth="1120" MinHeight="720" Icon="Assets/logo.png" WindowStartupLocation="CenterScreen">
 <Grid Background="{DynamicResource CanvasBrush}">
  <Grid.RowDefinitions><RowDefinition Height="88" /><RowDefinition Height="*" /><RowDefinition Height="32" /></Grid.RowDefinitions>
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
   <DockPanel Margin="28,0">
    <Button x:Name="ProfileButton" Click="ProfileClick" Width="176" BorderThickness="0" Padding="0,8,22,8" Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="打开我的个人资料与设置">
     <StackPanel Orientation="Horizontal">
      <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource TintBrush}" Margin="0,0,12,0"><Image x:Name="AvatarImage" Source="Assets/logo.png" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="23,23" RadiusX="23" RadiusY="23"/></Image.Clip></Image></Border>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="NicknameText" Text="学习者" FontWeight="SemiBold" FontSize="18" MaxWidth="100" TextTrimming="CharacterEllipsis" /><TextBlock Text="我的" FontSize="12" Style="{StaticResource MutedText}" Margin="0,3,0,0" /></StackPanel>
     </StackPanel>
    </Button>
    <Border Width="1" Background="{DynamicResource LineBrush}" Height="34" Margin="0,0,12,0" />
    <StackPanel x:Name="NavigationTabs" Orientation="Horizontal">
     <RadioButton x:Name="LibraryTab" Style="{StaticResource NavTab}" GroupName="Navigation" Content="题库" Tag="&#xE7C3;" Checked="Navigate" />
     <RadioButton Style="{StaticResource NavTab}" GroupName="Navigation" Content="刷题" Tag="&#xE70F;" Checked="Navigate" />
     <RadioButton Style="{StaticResource NavTab}" GroupName="Navigation" Content="模拟考试" Tag="&#xE8A5;" Checked="Navigate" />
     <RadioButton Style="{StaticResource NavTab}" GroupName="Navigation" Content="错题本" Tag="&#xE711;" Checked="Navigate" />
     <RadioButton Style="{StaticResource NavTab}" GroupName="Navigation" Content="考试记录" Tag="&#xE81C;" Checked="Navigate" />
    </StackPanel>
   </DockPanel>
  </Border>
  <ContentControl x:Name="PageHost" Grid.Row="1" />
  <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SurfaceBrush}"><TextBlock Text="界面预览 · 资料导入仍为示例；练习、错题与考试进度在本机保存" FontSize="12" Style="{StaticResource MutedText}" Margin="28,0" /></Border>
 </Grid>
</Window>
