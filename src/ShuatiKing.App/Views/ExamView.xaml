<UserControl x:Class="ShuatiKing.Views.ExamView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontSize="16" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources>
  <Style x:Key="TypeCircle" TargetType="CheckBox">
   <Setter Property="Width" Value="26"/><Setter Property="Height" Value="32"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Width="24" Height="24"><Ellipse x:Name="Ring" Stroke="{DynamicResource LineBrush}" StrokeThickness="2" Fill="{DynamicResource SurfaceBrush}"/><Ellipse x:Name="Dot" Margin="6" Fill="Transparent"/></Grid><ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Ring" Property="StrokeThickness" Value="3"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid Margin="30,24,30,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="模拟考试" Style="{StaticResource PageTitle}"/><TextBlock Text="按所选题型顺序出卷，题型内随机抽题；交卷后统一判分。" Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="2" x:Name="Setup" VerticalScrollBarVisibility="Auto"><StackPanel>
   <Border x:Name="ResumeCard" Background="{DynamicResource TintBrush}" Padding="20" CornerRadius="8" Margin="0,0,0,20" Visibility="Collapsed"><DockPanel><Button x:Name="ResumeExamButton" Content="打开上次考试" DockPanel.Dock="Right" Click="OpenPrevious"/><TextBlock x:Name="ResumeText" FontSize="18" TextWrapping="Wrap" Margin="0,0,18,0"/></DockPanel></Border>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="组卷设置" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,20"/><Label Content="题库" Target="{Binding ElementName=BankPicker}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,8"/><ComboBox x:Name="BankPicker" ItemTemplate="{StaticResource BankPickerTemplate}" SelectionChanged="SettingsChanged" AutomationProperties.Name="考试题库"/>
     <TextBlock Text="圆圈可独立勾选题型；长按“拖动”调整顺序，也可用上下箭头。" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="13" Margin="0,18,0,0"/><Grid Margin="0,16,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="题型" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="1" Text="题量" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="2" Text="每题分值" Style="{StaticResource MutedText}"/></Grid>
     <StackPanel x:Name="TypeRows"/><TextBlock Text="满分按已选题型的题量 × 分值累加，可低于或高于 100 分。" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
     <Label Content="考试时长（分钟）" Target="{Binding ElementName=MinutesInput}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,8" Margin="0,18,0,0"/><TextBox x:Name="MinutesInput" Text="30" MaxLength="4" AutomationProperties.Name="考试时长分钟"/>

    </StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top"><StackPanel><TextBlock Text="可用题量" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="AvailableCounts" TextWrapping="Wrap" LineHeight="30" Margin="0,18,0,20"/><TextBlock Text="多选题须全部选对，少选或错选不得分。填空题须所有空匹配才得分。" Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="26" FontSize="14"/><TextBlock Text="暂停或关闭软件会保存作答与剩余时间；重新打开后需手动继续。计时归零时自动交卷，未作答计零分。" Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="26" FontSize="14" Margin="0,18,0,0"/></StackPanel></Border>
   </Grid>
  </StackPanel></ScrollViewer>
  <Grid Grid.Row="2" x:Name="ExamPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition/></Grid.RowDefinitions>
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock x:Name="ClockText" Foreground="{DynamicResource AccentBrush}" FontSize="28" FontWeight="SemiBold" Margin="0,0,24,0"/><Button x:Name="PauseButton" Content="暂停考试" Click="PauseClick" Margin="0,0,12,0"/><Button x:Name="SubmitPaperButton" Content="交卷" Style="{StaticResource PrimaryButton}" Click="AskSubmit"/></StackPanel><StackPanel><TextBlock x:Name="PaperName" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="AnsweredCount" Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,0"/></StackPanel></DockPanel>
   <Grid Grid.Row="2" x:Name="QuizGrid"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="QuestionPosition" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16"/><ContentControl x:Name="QuestionHost"/></StackPanel></ScrollViewer><DockPanel Grid.Row="1" Margin="0,18,0,0"><Button x:Name="NextButton" Content="下一题" DockPanel.Dock="Right" Click="Next"/><Button x:Name="PreviousButton" Content="上一题" HorizontalAlignment="Left" Click="Previous"/></DockPanel></Grid></Border>
    <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top"><StackPanel><TextBlock Text="答题卡" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="浅蓝色表示已作答，点击编号切换。" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="13" Margin="0,10,0,18"/><ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="QuestionMap"/></ScrollViewer><Button Content="保存并返回设置" Click="BackToSetup" Margin="0,20,0,0"/></StackPanel></Border>
   </Grid>
   <Border Grid.Row="2" x:Name="PausedPanel" Style="{StaticResource Panel}" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620"><TextBlock Text="考试已暂停" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="作答与剩余时间已保存在本机。暂停时不计时，继续后恢复倒计时。" Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="28" TextAlignment="Center" Margin="0,20,0,26"/><Button x:Name="ContinueExamButton" Content="继续考试" Style="{StaticResource PrimaryButton}" Click="ResumeClick"/></StackPanel></Border>
   <Border x:Name="SubmitConfirmation" Grid.RowSpan="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="40" CornerRadius="8" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="确认交卷？" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="ConfirmText" TextWrapping="Wrap" LineHeight="28" Margin="0,20,0,24"/><TextBlock Text="确认期间倒计时继续；到时会自动交卷。" Style="{StaticResource MutedText}" FontSize="14" Margin="0,0,0,24"/><WrapPanel><Button x:Name="CancelSubmitButton" Content="继续作答" Click="CancelSubmit" Margin="0,0,12,0"/><Button x:Name="ConfirmSubmitButton" Content="确认交卷" Style="{StaticResource PrimaryButton}" Click="ConfirmSubmit"/></WrapPanel></StackPanel></Border>
  </Grid>
  <Border Grid.Row="2" x:Name="ResultPanel" Style="{StaticResource Panel}" VerticalAlignment="Top" Visibility="Collapsed"><StackPanel><TextBlock x:Name="ResultHeading" Text="已交卷" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="ResultScore" Foreground="{DynamicResource AccentBrush}" FontSize="40" FontWeight="SemiBold" Margin="0,22,0,18"/><TextBlock x:Name="ResultSummary" TextWrapping="Wrap" LineHeight="30"/><TextBlock Text="已保存本次作答与评分；错题已加入错题本，之后答对一次会自动移出。" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="14" Margin="0,20,0,24"/><WrapPanel><Button Content="返回组卷设置" Click="BackToSetup" Margin="0,0,12,0"/><Button Content="打开错题本" Click="OpenWrongs" Style="{StaticResource PrimaryButton}"/></WrapPanel></StackPanel></Border>
  <DockPanel Grid.Row="3" Margin="0,16,0,0"><Button x:Name="StartExamButton" Content="开始考试" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="StartExam" Visibility="{Binding ElementName=Setup, Path=Visibility}" Margin="20,0,0,0"/><TextBlock x:Name="PaperTotal" DockPanel.Dock="Right" FontSize="18" FontWeight="SemiBold" Margin="24,0,0,0" Visibility="{Binding ElementName=Setup, Path=Visibility}"/><TextBlock x:Name="Feedback" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="14" AutomationProperties.LiveSetting="Polite"/></DockPanel>
 </Grid>
</UserControl>
