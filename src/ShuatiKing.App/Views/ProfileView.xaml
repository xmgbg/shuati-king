<UserControl x:Class="ShuatiKing.Views.ProfileView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontSize="16" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,20"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="30,28,30,24">
   <TextBlock Text="我的" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="本机个人资料与偏好设置" Style="{StaticResource MutedText}" Margin="0,8,0,24"/>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel>
     <Border Style="{StaticResource Panel}">
      <StackPanel>
       <TextBlock Text="个人资料" Style="{StaticResource SectionTitle}"/>
       <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="60" Height="60" CornerRadius="30" HorizontalAlignment="Left" Background="{DynamicResource TintBrush}"><Image x:Name="ProfileAvatar" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/></Image.Clip></Image></Border>
        <StackPanel Grid.Column="1"><Button Content="选择头像" Click="ChooseAvatar" Padding="10,6" FontSize="13" MinHeight="32" Margin="0,0,0,6"/><Button Content="恢复默认" Click="ResetAvatar" Padding="10,6" FontSize="13" MinHeight="32"/></StackPanel>
       </Grid>
       <Label Content="昵称" Target="{Binding ElementName=NicknameInput}" Padding="0,0,0,8" Foreground="{DynamicResource TextBrush}"/>
       <TextBox x:Name="NicknameInput" MaxLength="20" AutomationProperties.Name="昵称"/>
       <TextBlock Text="最多 20 个字，当前电脑使用一个档案" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,18"/>
       <Button Content="保存个人资料" Style="{StaticResource PrimaryButton}" Click="SaveProfile"/>
       <TextBlock x:Name="ProfileFeedback" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="13" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Panel}" Margin="0,20,0,0">
      <StackPanel>
       <TextBlock Text="个性化" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="界面主题" Margin="0,0,0,12"/>
       <UniformGrid Columns="3" Margin="0,0,0,20">
        <RadioButton x:Name="LightTheme" Content="浅色" Tag="浅色" GroupName="Theme" Style="{StaticResource Choice}" Checked="ThemeChanged"/>
        <RadioButton x:Name="DarkTheme" Content="深色" Tag="深色" GroupName="Theme" Style="{StaticResource Choice}" Checked="ThemeChanged"/>
        <RadioButton x:Name="SystemTheme" Content="跟随系统" Tag="跟随系统" GroupName="Theme" Style="{StaticResource Choice}" Checked="ThemeChanged"/>
       </UniformGrid>
       <TextBlock Text="题目字号" Margin="0,0,0,12"/>
       <UniformGrid Columns="4" Margin="0,0,0,16">
        <RadioButton x:Name="Font16" Content="16" Tag="16" GroupName="Font" Style="{StaticResource Choice}" Checked="FontChanged"/>
        <RadioButton x:Name="Font18" Content="18" Tag="18" GroupName="Font" Style="{StaticResource Choice}" Checked="FontChanged"/>
        <RadioButton x:Name="Font20" Content="20" Tag="20" GroupName="Font" Style="{StaticResource Choice}" Checked="FontChanged"/>
        <RadioButton x:Name="Font22" Content="22" Tag="22" GroupName="Font" Style="{StaticResource Choice}" Checked="FontChanged"/>
       </UniformGrid>
       <Border Background="{DynamicResource TintBrush}" Padding="14" CornerRadius="6"><StackPanel><TextBlock Text="题目预览" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,8"/><TextBlock x:Name="QuestionPreview" Text="网络层的主要功能是什么？" TextWrapping="Wrap"/></StackPanel></Border>
       <TextBlock x:Name="PreferenceFeedback" Text="选择后自动保存" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
     </Border>
    </StackPanel>
    <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top"><ContentControl x:Name="AiHost"/></Border>
   </Grid>
  </StackPanel>
 </ScrollViewer>
</UserControl>
