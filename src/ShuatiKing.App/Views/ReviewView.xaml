<UserControl x:Class="ShuatiKing.Views.ReviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontSize="16" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="30,24,30,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="66"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ReturnButton" Content="返回资料" Click="Return" Margin="0,0,10,0"/><Button x:Name="HomeButton" Content="返回题库" Click="Home" Margin="0,0,10,0"/><Button x:Name="ExportButton" Content="导出题库" Click="Export"/></StackPanel><StackPanel><TextBlock Text="题目查看与审核" Style="{StaticResource PageTitle}"/><TextBlock x:Name="LibraryCaption" Style="{StaticResource MutedText}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel></DockPanel>
  <DockPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock x:Name="ReviewSummary" FontSize="15"/><TextBlock Text="切换题目时自动保存草稿；确认入库需手动操作。" Style="{StaticResource MutedText}" FontSize="13" HorizontalAlignment="Right"/></DockPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <UniformGrid Columns="4" Margin="0,0,0,14"><RadioButton x:Name="AllFilter" Content="全部" IsChecked="True" Tag="all" GroupName="ReviewFilter" Style="{StaticResource Choice}" Checked="FilterChanged"/><RadioButton x:Name="PendingFilter" Content="待确认" Tag="pending" GroupName="ReviewFilter" Style="{StaticResource Choice}" Checked="FilterChanged"/><RadioButton x:Name="IncompleteFilter" Content="待补全" Tag="incomplete" GroupName="ReviewFilter" Style="{StaticResource Choice}" Checked="FilterChanged"/><RadioButton x:Name="ConfirmedFilter" Content="已入库" Tag="confirmed" GroupName="ReviewFilter" Style="{StaticResource Choice}" Checked="FilterChanged"/></UniformGrid>
    <DockPanel Grid.Row="1" Margin="0,0,0,12"><CheckBox x:Name="SelectAllCheck" Content="全选当前列表" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Click="SelectAll"/><TextBlock x:Name="SelectionCount" Style="{StaticResource MutedText}" FontSize="12" HorizontalAlignment="Right"/></DockPanel>
    <Grid Grid.Row="2"><ListBox x:Name="QuestionList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="QuestionSelected" AutomationProperties.Name="待审核与已入库题目">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="QuestionRow" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="QuestionRow" Property="Background" Value="{DynamicResource TintBrush}"/><Setter TargetName="QuestionRow" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="QuestionRow" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="QuestionRow" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding BatchSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,3,0,0" Click="BatchSelectionChanged" AutomationProperties.Name="{Binding Stem, StringFormat=勾选题目：{0}}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Stem}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" FontSize="14" ToolTip="{Binding Stem}"/><TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox><TextBlock x:Name="EmptyList" Text="当前分类没有题目" Visibility="Collapsed" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
    <StackPanel Grid.Row="3" Margin="0,12,0,0"><Button x:Name="BatchConfirmButton" Content="批量确认入库" Style="{StaticResource PrimaryButton}" Click="BatchConfirm"/><TextBlock Text="答案完整的勾选题目才会入库；缺项会继续保留。" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
   </Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="24"><Grid x:Name="EditorRoot"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
     <DockPanel Margin="0,0,0,18"><TextBlock x:Name="QuestionStatus" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontSize="14"/><TextBlock Text="编辑题目" FontSize="21" FontWeight="SemiBold"/></DockPanel>
     <Label Content="题型" Target="{Binding ElementName=QuestionTypeInput}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,8"/><ComboBox x:Name="QuestionTypeInput" SelectionChanged="TypeChanged" AutomationProperties.Name="题型"><ComboBoxItem Content="单选题"/><ComboBoxItem Content="多选题"/><ComboBoxItem Content="判断题"/><ComboBoxItem Content="填空题"/></ComboBox>
     <Label Content="题干" Target="{Binding ElementName=StemInput}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,8" Margin="0,18,0,0"/><TextBox x:Name="StemInput" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextChanged="StemEdited" AutomationProperties.Name="题干"/>
     <StackPanel x:Name="ChoiceAnswers" Margin="0,18,0,0"><DockPanel Margin="0,0,0,10"><Button x:Name="AddOptionButton" Content="＋ 添加选项" DockPanel.Dock="Right" Click="AddOption" MinHeight="32" Padding="10,6" FontSize="13"/><TextBlock x:Name="ChoiceHint" Text="选项与正确答案"/></DockPanel><StackPanel x:Name="OptionsPanel"/></StackPanel>
     <StackPanel x:Name="JudgmentAnswers" Margin="0,18,0,0" Visibility="Collapsed"><TextBlock Text="正确答案" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="TrueAnswer" Content="正确" GroupName="JudgmentAnswer" Style="{StaticResource Choice}" Margin="0,0,12,0"/><RadioButton x:Name="FalseAnswer" Content="错误" GroupName="JudgmentAnswer" Style="{StaticResource Choice}"/></StackPanel></StackPanel>
     <StackPanel x:Name="BlankAnswers" Margin="0,18,0,0" Visibility="Collapsed"><Label Content="每个空的可接受答案" Target="{Binding ElementName=BlankAnswersInput}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,8"/><TextBlock Text="题干用 ____ 标记每个空。每行对应一个空，同一空的不同答案用 | 分隔。判分忽略首尾空白与英文大小写。" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBox x:Name="BlankAnswersInput" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="填空可接受答案"/></StackPanel>
     <Label Content="解析（可选）" Target="{Binding ElementName=ExplanationInput}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,8" Margin="0,18,0,0"/><TextBox x:Name="ExplanationInput" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="题目解析"/>
     <Border x:Name="ValidationPanel" Background="{DynamicResource WarningTintBrush}" Padding="12" CornerRadius="6" Margin="0,16,0,0" Visibility="Collapsed"><TextBlock x:Name="ValidationHint" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="14" AutomationProperties.LiveSetting="Polite"/></Border>
     <Expander Header="保留原文 · 供检查和修正" Foreground="{DynamicResource MutedBrush}" Margin="0,20,0,0"><TextBox x:Name="OriginalText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto" FontSize="13" Margin="0,10,0,0"/></Expander>
     <Expander Header="题目字号预览" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,0"><TextBlock x:Name="QuestionPreview" TextWrapping="Wrap" Margin="0,12,0,0"/></Expander>
    </StackPanel></ScrollViewer>
    <Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="SaveQuestionButton" Content="保存修改" Click="SaveQuestion"/><Button Grid.Column="2" x:Name="ConfirmQuestionButton" Content="确认入库" Style="{StaticResource PrimaryButton}" Click="ConfirmQuestion"/></Grid>
   </Grid></Border>
  </Grid>
  <TextBlock Grid.Row="3" x:Name="ReviewFeedback" Text="草稿与审核结果仅保留在本次运行；未完成答案不会进入可练习题库。" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="14" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</UserControl>
