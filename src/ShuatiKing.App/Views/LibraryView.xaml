<UserControl x:Class="ShuatiKing.Views.LibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="30,28,30,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button Content="&#xE898;  导入资料" FontFamily="Microsoft YaHei UI, Segoe MDL2 Assets" Style="{StaticResource PrimaryButton}" Click="PreviewAction" Tag="导入资料" Margin="0,0,12,0"/>
     <Button Content="&#xE8B5;  导入题库" FontFamily="Microsoft YaHei UI, Segoe MDL2 Assets" Click="PreviewAction" Tag="导入题库"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal"><TextBlock Text="我的题库" Style="{StaticResource PageTitle}"/><TextBlock Text="每份资料，一个题库" Style="{StaticResource MutedText}" Margin="24,0,12,0"/></StackPanel>
   </DockPanel>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.62*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*" MinWidth="318"/></Grid.ColumnDefinitions>
    <StackPanel>
     <Border Background="{DynamicResource TintBrush}" CornerRadius="8" Padding="24" Margin="0,0,0,24">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="38" Foreground="{DynamicResource AccentBrush}" Margin="0,0,18,0"/>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="继续上次练习" Style="{StaticResource MutedText}"/><TextBlock Text="计算机网络基础" FontWeight="SemiBold" FontSize="17" Margin="0,6,0,0"/></StackPanel>
       <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,22,0"><TextBlock Text="23 / 60 题" FontSize="18" Margin="0,0,0,10"/><ProgressBar Value="23" Maximum="60" Height="8" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource LineBrush}" BorderThickness="0"/></StackPanel>
       <Button Grid.Column="3" Content="继续练习" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="PreviewAction" Tag="继续练习" Padding="18,10"/>
      </Grid>
     </Border>
     <Grid Margin="24,0,20,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
      <TextBlock Text="题库名称" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="1" Text="资料来源" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="2" Text="题目数量" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="3" Text="状态" Style="{StaticResource MutedText}"/>
     </Grid>
     <ListBox x:Name="LibraryList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="示例题库列表">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
       <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,4"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" CornerRadius="6">
         <Grid><Border x:Name="SelectedLine" Width="4" HorizontalAlignment="Left" Background="Transparent" CornerRadius="3"/><ContentPresenter Margin="24,22,20,22"/></Grid>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource TintBrush}"/><Setter TargetName="Row" Property="BorderThickness" Value="0"/><Setter TargetName="SelectedLine" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource TintBrush}"/></Trigger>
         <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></Setter.Value></Setter>
      </Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="28" Foreground="{Binding Color}"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></Grid>
        <TextBlock Grid.Column="1" Text="{Binding Source}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" Margin="0,0,12,0"/>
        <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat={}{0} 题}"/>
        <Border Grid.Column="3" Style="{StaticResource StatusBadge}"><TextBlock Text="{Binding Status}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag}" FontWeight="SemiBold" HorizontalAlignment="Center"/></Border>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Text="ⓘ  示例数据" Style="{StaticResource MutedText}" FontSize="12" Margin="4,16,0,0"/>
    </StackPanel>
    <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top" Padding="26" DataContext="{Binding SelectedItem, ElementName=LibraryList}">
     <StackPanel>
      <TextBlock Text="题库详情" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,26"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="46" Foreground="{Binding Color}" VerticalAlignment="Top" Margin="0,4,0,0"/>
       <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Source, StringFormat=来源：{0}}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,14"/><WrapPanel><TextBlock Text="{Binding Count, StringFormat={}{0} 题}" FontSize="18" Margin="0,0,16,0"/><Border Style="{StaticResource StatusBadge}"><TextBlock Text="{Binding Status}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag}" FontWeight="SemiBold"/></Border></WrapPanel></StackPanel>
      </Grid>
      <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,24"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
       <TextBlock Text="单选题" Style="{StaticResource DetailLabel}"/><TextBlock Grid.Column="1" Text="{Binding Single}" Style="{StaticResource DetailLabel}"/>
       <TextBlock Grid.Row="1" Text="多选题" Style="{StaticResource DetailLabel}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Multiple}" Style="{StaticResource DetailLabel}"/>
       <TextBlock Grid.Row="2" Text="判断题" Style="{StaticResource DetailLabel}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Judgment}" Style="{StaticResource DetailLabel}"/>
       <TextBlock Grid.Row="3" Text="填空题" Style="{StaticResource DetailLabel}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Blank}" Style="{StaticResource DetailLabel}"/>
      </Grid>
      <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,20"/>
      <Button Content="{Binding Action}" HorizontalAlignment="Left" BorderThickness="0" Padding="0,8" Click="PreviewAction" Tag="题目管理" Margin="0,0,0,16"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Button Content="开始练习" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsReady}" Click="PreviewAction" Tag="开始练习" Padding="8,12"/>
       <Button Grid.Column="2" Content="模拟考试" IsEnabled="{Binding IsReady}" Click="PreviewAction" Tag="模拟考试" Padding="8,12"/>
      </Grid>
      <TextBlock x:Name="PendingHint" Text="审核通过后，即可练习和考试" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsReady}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>
 </ScrollViewer>
</UserControl>
