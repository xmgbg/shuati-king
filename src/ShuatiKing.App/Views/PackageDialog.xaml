<Window x:Class="ShuatiKing.Views.PackageDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Width="760" Height="650" MinWidth="620" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Background="{DynamicResource CanvasBrush}" Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="DialogHeading" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="DialogDescription" Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,18"/></StackPanel>
  <StackPanel Grid.Row="1"><WrapPanel x:Name="ImportActions" Margin="0,0,0,12"><Button Content="选择题库包" Click="ChoosePackage" Margin="0,0,12,0"/><Button x:Name="LoadPackageExampleButton" Content="载入示例题库" Click="LoadExample"/></WrapPanel><TextBlock x:Name="PackageFeedback" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite"/></StackPanel>
  <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="16"><TextBox x:Name="PackageContent" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" FontSize="14" VerticalContentAlignment="Top" AutomationProperties.Name="题库包内容预览"/></Border>
  <DockPanel Grid.Row="3" Margin="0,18,0,0"><Button x:Name="PackageConfirmButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="导入示例题库" Click="Confirm" IsEnabled="False"/><TextBlock Text="前端流程预览 · 不读取或写出真实题库包" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,18,0"/></DockPanel>
 </Grid>
</Window>
